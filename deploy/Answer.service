[Unit]
Description=Answer learning application
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Answer
ExecStart=/usr/bin/node /opt/Answer/backend/server.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=DATA_DIR=/opt/Answer/data
Restart=always
RestartSec=3
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
